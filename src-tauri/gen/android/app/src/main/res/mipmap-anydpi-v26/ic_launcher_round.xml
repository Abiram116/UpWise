<?xml version="1.0" encoding="utf-8"?>
<!-- Vector owl on an emerald gradient, plus a monochrome layer so Android's themed icons can tint it to match the home screen. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_bg"/>
  <foreground android:drawable="@drawable/ic_launcher_owl"/>
  <monochrome android:drawable="@drawable/ic_launcher_owl_mono"/>
</adaptive-icon>
