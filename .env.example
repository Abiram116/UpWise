# Supabase project settings — Project Settings > API in your Supabase dashboard.
# The anon key is safe to ship in the app; access is controlled by Row Level Security policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: Groq and YouTube Data API keys do NOT go in this file.
# They're set as Supabase Edge Function secrets instead, so they never get
# bundled into the built APK/exe. Once the edge functions are scaffolded,
# set them with:
#   supabase secrets set GROQ_API_KEY=your-key
#   supabase secrets set YOUTUBE_API_KEY=your-key

# Built-in single-user account (the app signs in silently with this; no login screen).
# Any email works (no confirmation mail is sent). Use a long random password.
VITE_APP_NAME=Your Name
VITE_APP_EMAIL=you@example.com
VITE_APP_PASSWORD=change-me-to-something-long-and-random
